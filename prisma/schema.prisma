// Prisma Schema: Aksaventra Engine Validation & Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  AUDITOR
}

enum EngineStatus {
  VALID
  REVOKED
  PENDING
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum LicenseValidationResult {
  ACTIVATED
  VERIFIED
  NOT_FOUND
  EXPIRED
  SUSPENDED
  HWID_MISMATCH
  BAD_REQUEST
}

enum ReleaseChannel {
  STABLE
  BETA
  NIGHTLY
}

// ----------------------------------------------------
// USER & AUTHENTICATION MODELS
// ----------------------------------------------------

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  password    String // Password hash (e.g. bcrypt/argon2)
  role        UserRole  @default(ADMIN)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ----------------------------------------------------
// ENGINE VALIDATION CORE MODELS (Issue #001 & #39)
// ----------------------------------------------------

model EngineValidation {
  id            String       @id @default(uuid())
  version       String       @unique
  sha256Hash    String
  fileSize      BigInt
  status        EngineStatus @default(VALID)
  signature     String
  downloadUrl   String
  verifiedCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  logs ValidationLog[]

  @@map("engine_validations")
}

model ValidationLog {
  id                 String           @id @default(uuid())
  engineValidationId String
  engineValidation   EngineValidation @relation(fields: [engineValidationId], references: [id], onDelete: Cascade)
  clientIp           String
  userAgent          String?
  isValid            Boolean
  checkedAt          DateTime         @default(now())

  @@index([engineValidationId])
  @@index([checkedAt])
  @@map("validation_logs")
}

// ----------------------------------------------------
// AUDIT LOG MODEL (Security & Admin Activity Tracking)
// ----------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "REGISTER_ENGINE", "REVOKE_ENGINE", "LOGIN"
  target    String? // e.g. "EngineValidation:v1.2.0"
  details   String? // JSON string or summary of action
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------
// LICENSE MANAGEMENT & HARDWARE LOCKING (Issue #13)
// ----------------------------------------------------

model License {
  id             String        @id @default(uuid())
  serialKey      String        @unique @map("serial_key")
  hwid           String?       @map("hwid")
  clientName     String        @map("client_name")
  vaultSecret    String        @map("vault_secret")
  status         LicenseStatus @default(ACTIVE)
  expiresAt      DateTime?     @map("expires_at")
  activatedAt    DateTime?     @map("activated_at")
  lastVerifiedAt DateTime?     @map("last_verified_at")
  engineVersion  String?       @map("engine_version")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  validationLogs LicenseValidationLog[]

  @@index([serialKey])
  @@index([hwid])
  @@map("licenses")
}

// ----------------------------------------------------
// LICENSE VALIDATION AUDIT LOG (Issue #20 & FR-06)
// ----------------------------------------------------

model LicenseValidationLog {
  id            String                  @id @default(uuid())
  licenseId     String?                 @map("license_id")
  license       License?                @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  serialKeyHint String                  @map("serial_key_hint")
  hwidHash      String?                 @map("hwid_hash")
  result        LicenseValidationResult
  statusCode    Int                     @map("status_code")
  engineVersion String?                 @map("engine_version")
  clientIp      String?                 @map("client_ip")
  userAgent     String?                 @map("user_agent")
  latencyMs     Int?                    @map("latency_ms")
  checkedAt     DateTime                @default(now()) @map("checked_at")

  @@index([checkedAt])
  @@index([result, checkedAt])
  @@index([licenseId])
  @@map("license_validation_logs")
}

// ----------------------------------------------------
// ENGINE RELEASE & AUTO-UPDATER (Issue #21)
// ----------------------------------------------------

model EngineRelease {
  id                  String         @id @default(uuid())
  version             String         @unique
  channel             ReleaseChannel @default(STABLE)
  minSupportedVersion String?        @map("min_supported_version")
  mandatory           Boolean        @default(false)
  downloadUrl         String?        @map("download_url")
  filePath            String?        @map("file_path")
  checksumSha256      String         @map("checksum_sha256")
  fileSize            BigInt         @map("file_size")
  releaseNotes        String?        @map("release_notes")
  isActive            Boolean        @default(true) @map("is_active")
  downloadCount       Int            @default(0) @map("download_count")
  publishedAt         DateTime       @default(now()) @map("published_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  updateLogs          EngineUpdateLog[]

  @@index([channel, isActive])
  @@index([publishedAt])
  @@map("engine_releases")
}

model EngineUpdateLog {
  id            String         @id @default(uuid())
  releaseId     String?        @map("release_id")
  release       EngineRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  clientVersion String         @map("client_version")
  hwid          String?        @map("hwid")
  serialKey     String?        @map("serial_key")
  channel       String         @default("stable")
  action        String         @default("CHECK") // CHECK | DOWNLOAD
  status        String         @default("SUCCESS") // SUCCESS | FAILED
  clientIp      String?        @map("client_ip")
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([releaseId])
  @@index([action, createdAt])
  @@map("engine_update_logs")
}
